{{ 'drive-fresh.css' | asset_url | stylesheet_tag }}

{% comment %}
  Floating contact buttons, bottom-right on every page. Lives in the footer
  group. Each button only shows when its setting is filled in.
{% endcomment %}
{%- if section.settings.whatsapp != blank or section.settings.email != blank -%}
  <div class="df-float" role="complementary" aria-label="Contact us">
    {%- if section.settings.whatsapp != blank -%}
      {%- assign wa_digits = section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
      <a
        class="df-float__btn df-float__btn--wa"
        href="https://wa.me/{{ wa_digits }}"
        target="_blank"
        rel="noopener"
        aria-label="Message us on WhatsApp"
      >
        <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.3-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.3 3.5c.2.2 2.4 3.6 5.8 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5 0-.2-.3-.3-.6-.4z"/></svg>
      </a>
    {%- endif -%}
    {%- if section.settings.email != blank -%}
      <a
        class="df-float__btn df-float__btn--mail"
        href="mailto:{{ section.settings.email }}"
        aria-label="Email us"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="m3 7 9 6 9-6"/></svg>
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DF Floating contact",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp number",
      "info": "Full number with country code, e.g. +1 315 629 9498. Leave blank to hide the button."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "info": "Leave blank to hide the button."
    }
  ],
  "presets": [
    {
      "name": "DF Floating contact"
    }
  ]
}
{% endschema %}
