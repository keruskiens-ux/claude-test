{{ 'golf-empire.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="ge-timeline__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ol class="ge-timeline" role="list">
      {%- for block in section.blocks -%}
        <li class="ge-timeline__step" {{ block.shopify_attributes }}>
          {%- if block.settings.when != blank -%}
            <p class="ge-timeline__when">{{ block.settings.when | escape }}</p>
          {%- endif -%}
          <h3 class="ge-timeline__title h4">{{ block.settings.title | escape }}</h3>
          <div class="ge-timeline__text rte">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank -%}
      <div class="ge-timeline__note rte">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GE Delivery timeline",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What happens after you order"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note",
      "default": "<p>If we can't ship your order within our stated 2–4 week window, you can cancel for a full refund. Full details in our <a href=\"/pages/return-policy\" title=\"Return policy\">return policy</a>.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "when",
          "label": "When",
          "default": "Day 0"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Order confirmed"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>You get a confirmation email right away.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GE Delivery timeline",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
